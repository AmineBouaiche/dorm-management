APP_NAME=Dorm Management System
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://dorm:dorm@localhost:5432/dorm_management

# Development placeholder only. Generate a unique secret of at least 32 characters
# before setting ENVIRONMENT=production.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=dorm-management
JWT_AUDIENCE=dorm-management-web
ACCESS_TOKEN_EXPIRE_MINUTES=60
